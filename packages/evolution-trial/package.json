{
  "name": "@hourglass/evolution-trial",
  "version": "0.1.0",
  "description": "Trial-side runtime for the hourglass self-evolution safety sandbox: immutable content-addressed candidate store, hash-chain evolution journal, one-shot confined trial-driver launcher, and validation-pack export",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@hourglass/evolution-contract": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  }
}
