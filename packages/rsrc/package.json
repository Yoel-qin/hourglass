{
  "name": "@hourglass/sandbox-rsrc",
  "version": "0.1.0",
  "description": "Resource quotas for the DSH bwrap rung: prlimit hard caps (processes, address space, cpu, file size, open files) injected ahead of the wrapped command; kernel-enforced, fail-closed on non-bwrap rungs",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-sandbox": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-sandbox": "workspace:*"
  }
}
