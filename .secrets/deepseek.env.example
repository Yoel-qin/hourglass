# Copy this file to .secrets/deepseek.env (gitignored) and paste your key.
# The real file is injected ONLY via `docker run --env-file`; it never enters
# git, chat, or the trial child process (the host-side broker holds it).
#
#   cp .secrets/deepseek.env.example .secrets/deepseek.env
#   # edit .secrets/deepseek.env, set DEEPSEEK_API_KEY=sk-...
#
# Then run the real lane (minimal subset first — see docs/evolution/runbook.md §9):
#   docker run --rm --privileged \
#     --env-file .secrets/deepseek.env \
#     -e HOURGLASS_AGENT_LANE_REAL=1 \
#     -e AGENT_LANE_TASKS=z-from-ci \
#     -v "$(pwd -W)/reports:/opt/reports" \
#     hourglass-test hourglass-entrypoint agent-lane-real
DEEPSEEK_API_KEY=
