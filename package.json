{
  "name": "hourglass",
  "version": "0.1.0",
  "private": true,
  "description": "DSH sandbox governance plugin: audit ledger, capability manifest, policy CI, and reproducible open-source sandbox comparison",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gate:versions-lock": "node --experimental-strip-types scripts/sandbox-compare/validate-versions-lock.ts",
    "golden:policy-ci": "node --experimental-strip-types packages/policy-ci/tests/generate-golden.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "compare": "node --experimental-strip-types scripts/sandbox-compare/run.ts"
  }
}
